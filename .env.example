# Copy this file to .env to change the defaults. Every value is optional.

# Local SQLite database (created automatically on first run)
HIRESENSE_DB_PATH=data/hiresense.sqlite3

# Largest accepted upload, in MB
HIRESENSE_MAX_UPLOAD_MB=5

# Optional: Gemini rewrites for resume bullets. Leave empty to use rule-based suggestions only.
GEMINI_API_KEY=
# HIRESENSE_LLM_MODEL=gemini-3.6-flash
